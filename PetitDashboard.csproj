<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><UseAppHost>false</UseAppHost>
    <ApplicationIcon>assets\petit_dash_compact_v2.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest><AssemblyName>PetitDashboard</AssemblyName>
    <StartupObject>PetitDashboard.Program</StartupObject>
    <DefaultItemExcludes>$(DefaultItemExcludes);verification\**;artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup><Resource Include="assets\background.png"/><Resource Include="assets\logo.png"/><Resource Include="assets\petit_dash_compact_v2.ico"/></ItemGroup>
</Project>
