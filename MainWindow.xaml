<Window x:Class="PetitDashboard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="쁘띠테라스 업무 대시보드" Icon="assets/petit_dash_compact_v2.ico" Width="1100" Height="618.75" WindowStyle="None" ResizeMode="NoResize" Background="#E8F1FC">
 <Viewbox Stretch="Uniform"><Grid Width="1100" Height="618.75">
  <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/><RowDefinition Height="35"/></Grid.RowDefinitions>
  <Border Background="#E7EFFA" MouseLeftButtonDown="DragHeader"><Grid Margin="22,0,12,0"><TextBlock Text="쁘띠테라스 업무 대시보드  v1.0" VerticalAlignment="Center" FontSize="14"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ManageButton" Content="프로그램 관리" Click="Manage" Margin="0,3,18,3" Padding="12,4"/><Button Content="—" Click="Minimize" Margin="0,3,5,3" Padding="12,4"/><Button Content="✕" Click="CloseDashboard" Margin="0,3,0,3" Padding="12,4"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1">
   <Grid.Background><ImageBrush ImageSource="assets/background.png" Stretch="UniformToFill"/></Grid.Background>
   <Grid Margin="80,26,80,0" Height="117" VerticalAlignment="Top">
    <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Image Source="assets/logo.png" Width="390" Height="127" Stretch="Uniform" HorizontalAlignment="Left"/>
    <Border Grid.Column="1" Background="#769AC6" Margin="0,12"/>
    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="함께 만드는" FontSize="23" Foreground="#466997"/><TextBlock Text="더 좋은 상가" FontSize="23" Foreground="#466997" Margin="28,5,0,0"/><Border Height="2" Background="#80B8EA" Margin="24,9,0,0"/></StackPanel>
   </Grid>
   <ItemsControl x:Name="Cards" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,172,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,9"><Button x:Name="Previous" Content="←" Click="PreviousPage" Width="44" Padding="12,4"/><TextBlock x:Name="PageLabel" Width="90" TextAlignment="Center" VerticalAlignment="Center"/><Button x:Name="Next" Content="→" Click="NextPage" Width="44" Padding="12,4"/></StackPanel>
   <Border Background="#EFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,142,0,0" CornerRadius="6" Padding="12,5" Visibility="Collapsed" x:Name="StatusBox"><TextBlock x:Name="StatusText"/></Border>
  </Grid>
  <Border Grid.Row="2" Background="#E7EFFA"><Grid Margin="22,0"><TextBlock Text="PETIT TERRACE  |  업무 대시보드" Foreground="#5D7EA8" FontSize="12" VerticalAlignment="Center"/><Button Content="종료" HorizontalAlignment="Right" Click="CloseDashboard" Padding="12,4" Margin="0,3"/></Grid></Border>
 </Grid></Viewbox>
</Window>
